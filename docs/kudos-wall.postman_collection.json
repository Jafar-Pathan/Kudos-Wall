              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": { \"data\": { \"json\": { \"allowance\": 72, \"received\": 14, \"sent\": 8 } } }\n}"
            }
          ]
        },
        {
          "name": "Give kudos (protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": {{recipientId}},\n  \"points\": 20,\n  \"message\": \"Thank you for making the launch feel easy and focused.\",\n  \"tags\": [\"#Teamwork\", \"#Innovation\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/kudos.give",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "kudos.give"
              ]
            },
            "description": "Requires Authorization: Bearer <accessToken>. Points must be exactly 10, 20, or 50; message length is 8\u2013280 characters; tags must contain 1\u20133 supported values."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": { \"data\": { \"json\": { \"id\": 42, \"recipientName\": \"Maya Patel\" } } }\n}"
            },
            {
              "name": "Unauthorized",
              "originalRequest": {},
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": { \"json\": { \"message\": \"Please login (10001)\", \"data\": { \"code\": \"UNAUTHORIZED\" } } }\n}"
            }
          ]
        },
        {
          "name": "React to kudos (protected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kudosId\": {{kudosId}},\n  \"reaction\": \"fire\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/kudos.react",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "kudos.react"
              ]
            },
            "description": "Requires a valid access JWT. Reaction must be thumbs, party, or fire."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": { \"data\": { \"json\": { \"fire\": 8, \"thumbs\": 12, \"party\": 4 } } }\n}"
            }
          ]
        }
      ]
    },
