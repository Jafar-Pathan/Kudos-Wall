{
  "info": {
    "_postman_id": "9e3e8c2e-4b44-4c6a-8b2a-7f6f10c9f13c",
    "name": "Kudos Wall API",
    "description": "Postman collection for the Kudos Wall Express + tRPC API. Email/password auth returns a short-lived access JWT and sets a seven-day rotating refresh token in the HTTP-only kudos_refresh_token cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "kudosId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "recipientId",
      "value": "2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Avery Morgan\",\n  \"email\": \"avery@example.com\",\n  \"password\": \"teamwork123\",\n  \"department\": \"Engineering\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/auth.signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "auth.signup"
              ]
            },
            "description": "Public procedure. Password must be at least 8 characters and contain at least one letter and one number. Success sets the HTTP-only kudos_refresh_token cookie and returns a 15-minute accessToken. Store the accessToken in the {{accessToken}} collection variable for protected requests."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": {\n    \"data\": {\n      \"json\": {\n        \"user\": { \"id\": 42, \"name\": \"Avery Morgan\", \"email\": \"avery@example.com\", \"role\": \"user\", \"department\": \"Engineering\" },\n        \"accessToken\": \"eyJ...\",\n        \"expiresIn\": 900\n      }\n    }\n  }\n}"
            },
            {
              "name": "Duplicate email",
              "originalRequest": {},
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"error\": { \"json\": { \"message\": \"An account with that email already exists.\", \"data\": { \"code\": \"CONFLICT\" } } }\n}"
            }
          ]
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"avery@example.com\",\n  \"password\": \"teamwork123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/auth.signin",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "auth.signin"
              ]
            },
            "description": "Public procedure. Success sets/replaces the HTTP-only refresh cookie and returns a new 15-minute access JWT. Invalid credentials return a generic 401 response."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": {\n    \"data\": {\n      \"json\": {\n        \"user\": { \"id\": 42, \"name\": \"Avery Morgan\", \"email\": \"avery@example.com\" },\n        \"accessToken\": \"eyJ...\",\n        \"expiresIn\": 900\n      }\n    }\n  }\n}"
            },
            {
              "name": "Invalid credentials",
              "originalRequest": {},
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": { \"json\": { \"message\": \"Email or password is incorrect.\", \"data\": { \"code\": \"UNAUTHORIZED\" } } }\n}"
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "kudos_refresh_token={{refreshToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/auth.refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "auth.refresh"
              ]
            },
            "description": "Public procedure, but requires the refresh cookie. The presented refresh token is revoked and replaced, preventing reuse. Update {{accessToken}} and {{refreshToken}} from the response Set-Cookie/header values in a real client."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": {\n    \"data\": { \"json\": { \"user\": { \"id\": 42 }, \"accessToken\": \"eyJ...\", \"expiresIn\": 900 } }\n  }\n}"
            },
            {
              "name": "Expired refresh token",
              "originalRequest": {},
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": { \"json\": { \"message\": \"Refresh token is invalid or expired.\", \"data\": { \"code\": \"UNAUTHORIZED\" } } }\n}"
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trpc/auth.me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "auth.me"
              ]
            },
            "description": "Requires a valid access JWT. Returns a sanitized user object without passwordHash or openId."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": { \"data\": { \"json\": { \"id\": 42, \"name\": \"Avery Morgan\", \"email\": \"avery@example.com\", \"role\": \"user\" } } }\n}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "kudos_refresh_token={{refreshToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/trpc/auth.logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trpc",
                "auth.logout"
              ]
            },
            "description": "Revokes the current refresh token and clears the HTTP-only refresh cookie. The access JWT remains cryptographically valid until its short expiry, so clients should discard it immediately."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "body": "{\n  \"result\": { \"data\": { \"json\": { \"success\": true } } }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Kudos",
      "item": [
        {
          "name": "Get overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trpc/kudos.overview",
